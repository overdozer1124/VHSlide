{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vhslide",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"],
  },
  "vars": { "GOOGLE_CLIENT_ID": "", "PUBLIC_ORIGIN": "" },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ROOMS", "class_name": "SlideRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Directory", "SlideRoom"] },
  ],
}
