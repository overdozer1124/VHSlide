{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vhslide",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"],
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "187339871113-2j074eot6i41e2ts1g3129ch87vhjru1.apps.googleusercontent.com",
    "GOOGLE_SCHOOL_CLIENT_ID": "142634110367-rongbdrtm1u416ch26orar134m50ttbi.apps.googleusercontent.com",
    "GOOGLE_SCHOOL_DOMAIN": "kaga.ed.jp",
    "PUBLIC_ORIGIN": "https://vhslide.overdozer1124.workers.dev",
  },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ROOMS", "class_name": "SlideRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Directory", "SlideRoom"] },
  ],
}
