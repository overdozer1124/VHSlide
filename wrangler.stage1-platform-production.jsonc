{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One-operation temporary build for the production Worker.
  // Upload with `wrangler versions upload` only, and only after the owner
  // approves that upload. Do not activate this build from this file alone.
  // STAGE1_SUBJECT, STAGE1_ONE_TIME and STAGE1_EXPIRES_AT are version secrets.
  // Do not put them in this file.
  "name": "vhslide",
  "main": "cloudflare/platform-temporary.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz", "/platform/apply", "/admin/*"],
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "187339871113-2j074eot6i41e2ts1g3129ch87vhjru1.apps.googleusercontent.com",
    "GOOGLE_SCHOOL_CLIENT_ID": "142634110367-rongbdrtm1u416ch26orar134m50ttbi.apps.googleusercontent.com",
    "GOOGLE_SCHOOL_DOMAIN": "kaga.ed.jp",
    "PUBLIC_ORIGIN": "https://vhslide.overdozer1124.workers.dev",
    "STAGE1_FEATURES": "1",
    "STAGE1_ENV_ID": "vhslide",
    "STAGE1_PURPOSE": "bootstrap",
    "STAGE1_OPERATION_ID": "op-bootstrap-vhslide-20261117",
  },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ROOMS", "class_name": "SlideRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Directory", "SlideRoom"] },
  ],
}
