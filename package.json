{
  "name": "vhslide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "node server/index.ts",
    "dev:server": "node --watch server/index.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src/model.test.ts src/sharedDeck.test.ts && npm run test:server",
    "test:server": "node --test tests/server/*.test.ts",
    "test:e2e": "playwright test",
    "test:cloud": "playwright test --config playwright.cloud.config.ts",
    "format": "prettier --write src server cloudflare tests docs README.md *.ts *.json index.html",
    "cf:check": "tsc -p tsconfig.cloudflare.json && wrangler deploy --dry-run --outdir .wrangler-build",
    "cf:dev": "npm run build && wrangler dev --port 8787 --var PUBLIC_ORIGIN:http://localhost:8787",
    "cf:deploy": "npm run build && tsc -p tsconfig.cloudflare.json && wrangler deploy",
    "test:cloudflare": "npm run cf:check && node --test tests/cloudflare/*.test.ts",
    "test:cloudflare:e2e": "playwright test --config playwright.cloudflare.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@dnd-kit/core": "^6.3.1",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "quill": "^2.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.22.0",
    "y-quill": "^1.0.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.4",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.151.3"
  }
}
