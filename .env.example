# Railway: set these in the service's Variables screen. Never commit real values.
NODE_ENV=production
DATA_DIR=/data
PUBLIC_ORIGIN=https://your-app.up.railway.app
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional Railway Storage Bucket. Set all four together, otherwise photos use DATA_DIR.
# BUCKET_ENDPOINT=https://t3.storageapi.dev
# BUCKET_NAME=
# BUCKET_ACCESS_KEY_ID=
# BUCKET_SECRET_ACCESS_KEY=
# BUCKET_REGION=auto

# Initial operating limits. Increase after checking Railway usage.
MAX_CONNECTIONS=200
MAX_ROOM_CONNECTIONS=50
MAX_DECKS_PER_USER=40
MAX_USER_ASSET_BYTES=250000000
MAX_TOTAL_ASSET_BYTES=5000000000
